# ─────────────────────────────────────────────────
# PatchR API — Backend Environment Variables
# Copy this to .env and fill in real values
# NEVER commit .env to git
# ─────────────────────────────────────────────────

# Database
DATABASE_URL=postgresql+asyncpg://patchr:patchr_dev@localhost:5432/patchr

# Redis
REDIS_URL=redis://:patchr_dev@localhost:6379/0

# Owner Auth
OWNER_PASSWORD=change_me_in_production
JWT_SECRET=change_me_in_production_jwt_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# NVIDIA NIM
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# GitHub (Phase 2)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Restrict OAuth sign-in to these comma-separated GitHub usernames in production.
# Leaving this blank permits any GitHub account to create an owner account.
GITHUB_ALLOWED_USERS=

# Vercel (Phase 3)
VERCEL_WEBHOOK_SECRET=
VERCEL_ACCESS_TOKEN=

# App
ENVIRONMENT=development
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO
